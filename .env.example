# Server
PORT=3200

# Database (production: MySQL; tests set DB_DIALECT=sqlite and skip all of this)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_appointments
DB_USER=root
DB_PASSWORD=

# Auth — MUST be the exact same values identity-admin-service signs with and
# organization-admin-service verifies with. This service only ever verifies
# tokens minted by identity-admin-service; it never signs its own.
ADMIN_JWT_SECRET=
ADMIN_JWT_AUDIENCE=
ADMIN_JWT_ISSUER=
# Only needed if ADMIN_JWT_SECRET is unset (RS256/JWKS verification instead
# of a shared HS256 secret) — see src/middleware/authentication.js.
ADMIN_JWKS_URL=

# CORS — comma-separated list of allowed origins. Falls back to permissive
# (dev-only) when unset.
ALLOWED_ORIGINS=http://localhost:4200
